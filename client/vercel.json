{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://quickpdfhd-api.onrender.com/api/:path*" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/privacy-policy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/jpg-to-pdf", "destination": "/index.html" },
    { "source": "/jpeg-to-pdf", "destination": "/index.html" },
    { "source": "/png-to-pdf", "destination": "/index.html" },
    { "source": "/webp-to-pdf", "destination": "/index.html" },
    { "source": "/document-scanner", "destination": "/index.html" },
    { "source": "/pdf-to-zip", "destination": "/index.html" },
    { "source": "/resize-image", "destination": "/index.html" },
    { "source": "/all-services", "destination": "/index.html" },
    { "source": "/word-to-pdf", "destination": "/index.html" },
    { "source": "/pdf-to-word", "destination": "/index.html" },
    { "source": "/excel-to-pdf", "destination": "/index.html" },
    { "source": "/pdf-to-excel", "destination": "/index.html" },
    { "source": "/split-pdf", "destination": "/index.html" },
    { "source": "/merge-pdf", "destination": "/index.html" },
    { "source": "/pdf-to-jpg", "destination": "/index.html" },
    { "source": "/pdf-guides", "destination": "/index.html" },
    { "source": "/pdf-guides/(.*)", "destination": "/index.html" }
  ]
}

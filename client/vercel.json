  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/privacy-policy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/jpg-to-pdf", "destination": "/index.html" },
    { "source": "/jpeg-to-pdf", "destination": "/index.html" },
    { "source": "/png-to-pdf", "destination": "/index.html" },
    { "source": "/webp-to-pdf", "destination": "/index.html" },
    { "source": "/document-scanner", "destination": "/index.html" },
    { "source": "/pdf-to-zip", "destination": "/index.html" },
    { "source": "/resize-image", "destination": "/index.html" },
    { "source": "/all-services", "destination": "/index.html" },
